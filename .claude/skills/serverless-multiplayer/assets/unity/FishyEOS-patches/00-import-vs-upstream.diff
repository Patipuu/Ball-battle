         /// </summary>
         private void OnPeerConnectionRequest(ref OnIncomingConnectionRequestInfo data)
         {
+            // A peer that was ungracefully killed (crash / force-stop / bg-timeout) leaves a stale
+            // connection here for its ProductUserId. When the same PUID reconnects, EOS reports the
+            // new session as a "Socket ID we already know about" and the fresh session is dropped.
+            // Evict any prior connection for this PUID first so the rejoin re-establishes cleanly.
+            EvictStaleConnections(data.RemoteUserId);
+
             var nextId = _latestId++;
             var clientConnection = new Connection(nextId, data.LocalUserId, data.RemoteUserId, data.SocketId);
             _clients.Add(clientConnection);
@@ -228,10 +234,22 @@ namespace FishNet.Transporting.FishyEOSPlugin
                 RemoveClosePeerConnectionHandle(data.RemoteUserId.ToString(), notificationId);
             }
 
+            // Fully close the EOS-internal P2P session for this peer. Without this, EOS keeps the
+            // session alive and, when the same ProductUserId reconnects, "ignores incoming invitation
+            // and resends existing session" — the rejoin never establishes. Closing it here lets a
+            // dropped (incl. hard-killed) peer reconnect cleanly.
+            var closeConnectionOptions = new CloseConnectionOptions
+            {
+                LocalUserId = _localUserId,
+                RemoteUserId = data.RemoteUserId,
+                SocketId = _socketId,
+            };
+            EOS.GetCachedP2PInterface()?.CloseConnection(ref closeConnectionOptions);
+
             _transport.HandleRemoteConnectionState(new RemoteConnectionStateArgs(RemoteConnectionState.Stopped,
                 clientConnection.Value.Id, _transport.Index));
             _transport.NetworkManager.Log($"[ServerPeer.OnPeerConnectionClosed] Closed connection from {data.RemoteUserId} with handle #{data.SocketId} and connection id {clientConnection.Value.Id}.");
