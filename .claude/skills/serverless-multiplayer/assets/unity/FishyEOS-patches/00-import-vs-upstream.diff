+
             _clients.Remove(clientConnection.Value);
         }
 
@@ -241,6 +259,44 @@ namespace FishNet.Transporting.FishyEOSPlugin
             _closePeerConnectionEventHandles.Remove(remoteUserId);
         }
 
+        /// <summary>
+        /// Removes any existing connection(s) for a remote user id before a fresh reconnect.
+        /// Closes the stale EOS P2P session, clears its notify handles, and tells FishNet the old
+        /// connection stopped so a hard-killed peer can rejoin without colliding on the same socket.
+        /// </summary>
+        private void EvictStaleConnections(ProductUserId remoteUserId)
+        {
+            for (int i = _clients.Count - 1; i >= 0; i--)
+            {
+                var stale = _clients[i];
+                if (stale.RemoteUserId != remoteUserId)
+                    continue;
+
+                var closeConnectionOptions = new CloseConnectionOptions
+                {
+                    LocalUserId = _localUserId,
+                    RemoteUserId = stale.RemoteUserId,
+                    SocketId = _socketId,
+                };
+                EOS.GetCachedP2PInterface()?.CloseConnection(ref closeConnectionOptions);
+
+                if (_establishPeerConnectionEventHandles.TryGetValue(stale, out var establishHandle))
+                {
+                    EOS.GetCachedP2PInterface()?.RemoveNotifyPeerConnectionEstablished(establishHandle);
+                    _establishPeerConnectionEventHandles.Remove(stale);
+                }
+
+                string staleRemoteId = stale.RemoteUserId.ToString();
+                if (_closePeerConnectionEventHandles.TryGetValue(staleRemoteId, out var closeHandle))
+                    RemoveClosePeerConnectionHandle(staleRemoteId, closeHandle);
+
+                _clients.RemoveAt(i);
+                _transport.HandleRemoteConnectionState(new RemoteConnectionStateArgs(RemoteConnectionState.Stopped,
+                    stale.Id, _transport.Index));
+                _transport.NetworkManager.Log($"[ServerPeer] Evicted stale connection id {stale.Id} for reconnecting peer {remoteUserId}.");
+            }
+        }
+
